#    "Right Half"                       !"wmctrl -r :ACTIVE: -e 0,1224,8,1200,1391"   # 2560x1440
#    "Top Half"                         !"wmctrl -r :ACTIVE: -e 0,8,8,2416,675"       # 2560x1440
#    "Bottom Half"                      !"wmctrl -r :ACTIVE: -e 0,8,724,2416,675"     # 2560x1440
#    "Fullscreen"                       !"wmctrl -r :ACTIVE: -e 0,8,8,2416,1391"      # 2560x1440

# This block is for windows without gaps on a 1920x1080
#    "Top Left"                         !"wmctrl -r :ACTIVE: -e 0,0,0,892,507"        # 1920x1080
#    "Top Right"                        !"wmctrl -r :ACTIVE: -e 0,900,0,892,507"      # 1920x1080
#    "Bottom Left"                      !"wmctrl -r :ACTIVE: -e 0,0,540,892,507"      # 1920x1080
