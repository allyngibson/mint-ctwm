#    "Top Right"                        !"wmctrl -r :ACTIVE: -e 0,904,8,880,495"      # 1920x1080
#    "Bottom Left"                      !"wmctrl -r :ACTIVE: -e 0,8,544,850,495"      # 1920x1080
