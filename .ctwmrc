#---------------------------------------------------------
# CTWMRC - STRANGE NEW WORLDS++++
#          Version 1.1-Mint Y - February 5, 2024
#          by Allyn Gibson
#
# Based on .ctwmrc-files by:
# * Morgan Eklof
# * Anders Skargren
# * Tomas Cedven
# * Peter C
# * Dan Lilliehorn
# * Steve Litt
#
# Legend:
# I=Icon(s)
# TB=TitleBar(s)
# IM=IconManager
# WS=WorkSpace
# WSM=WorkSpaceManager 
#---------------------------------------------------------

#---------------------------------------------------------
# EMERGENCY
# This line is here so that U will be able 2 restart CTWM
# even if the rest of the file doesn't work very well!
#---------------------------------------------------------

"F9" = s : r|w|t|m|f : f.quit  #shift "L2": source .ctwmrc

#---------------------------------------------------------      
# FONTS                                                 
#---------------------------------------------------------

TitleFont               "-adobe-helvetica-bold-r-normal--*-120-*-*-*-*-*-*"
ResizeFont              "-adobe-helvetica-bold-r-normal--*-120-*-*-*-*-*-*"
MenuFont                "-adobe-helvetica-bold-r-normal--*-120-*-*-*-*-*-*"
WorkspaceFont           "-adobe-helvetica-medium-r-*-*-12-*-*-*-*-*-*-*"
IconFont                "-adobe-helvetica-bold-r-normal--*-100-*-*-*-*-*-*"
IconManagerFont         "-adobe-helvetica-medium-r-normal--*-140-*-*-*-*-*-*"

#---------------------------------------------------------
# PIXMAP CONFIG and
# PIXMAPS
#---------------------------------------------------------

PixmapDirectory         "~/.local/share/ctwm/pixmap"      # dir. for xpms

Pixmaps {
     TitleHighlight      "dimple3"
}

#---------------------------------------------------------
# COLOR CONFIG and
# COLORS                                          
#---------------------------------------------------------

Color
{
  BorderColor           "#116D77"
  DefaultBackground     "#404040"
  DefaultForeground     "rgb:e/e/e"
  TitleBackground       "#2B2B2B"
  TitleForeground       "white" 
  BorderTileBackground  "#072E33"
  BorderTileForeground  "black"
  MenuBackground        "#2F2F2F"
  MenuForeground        "white"
  MenuTitleBackground   "#35A854"
  MenuTitleForeground   "white"
  MenuShadowColor       "gray15"     # default is black
  IconBackground        "#404040"
  IconForeground        "#F9F9F9"
  IconBorderColor       "#35A854"
  IconManagerBackground "#2C2C2C"
  IconManagerForeground "#F9F9F9"
  IconManagerHighlight  "yellow"
  MapWindowBackground   "AntiqueWhite"  # BG color for WSMwins
  MapWindowForeground   "gray4"      # FG color for WSMwins
}

SaveColor                            # tell client about these
{                                    # settings to "smooth"
     BorderColor
     TitleBackground
     TitleForeground
}

#---------------------------------------------------------
# MONOCHROME "COLOR"-SETTINGS
#---------------------------------------------------------

Monochrome
{
      BorderColor                    "black"
      BorderTileForeground           "black"
      BorderTileBackground           "white"
      TitleForeground                "black"
      TitleBackground                "white"
      MenuTitleForeground            "black"
      MenuTitleBackground            "white"
      MapWindowForeground            "white"
      MapWindowBackground            "white"
}

#---------------------------------------------------------
# GENERAL CTWM CONFIG                                         
#---------------------------------------------------------

ClickToFocus                         # Prevent mouse movement changing focus -- Steve Litt

RestartPreviousState                 # use previous if any

DecorateTransients                   # give transients TB
TransientHasOccupation               # ..uhh? Try it! What is it?
TransientOnTop                       # Put transients top when they appear 
AutoFocusToTransients                # Give transients autofocus.

OpaqueMove                           # want to see the window?
    {                                # optional app list
    }

NoGrabServer                         # no grab server on popup/opaque (?)

RaiseOnClick                         # raise window when clicked on
RaiseOnClickButton      1            # which button?

DontMoveOff                          # Add below & U get resistance
MoveOffResistance       150          # how hard must I push?

ConstrainedMoveTime     0            # How quick to 2click to constrain

#IgnoreLockModifier                   # Don't check locks for bindings (CAPS)
IgnoreModifier {
  lock                               # Ignore Caps Lock (Note: doesn't seem to work)
  m2                                 # Ignore Num Lock
}

RandomPlacement         "on"         # ask for pos?
MoveDelta               3            # dist. 4 move 2 work
AnimationSpeed          15           # update speed for animated things
ClearShadowContrast     50           # clear shadow for 3D
DarkShadowContrast      50           # dark shadow for 3D
MovePackResistance      100          # how many pix. res. be4 overlap?
UsePPosition            "on"         # let the apps have their way?
#RaiseDelay             10           # how long delay raise? - Steve Litt

RaiseWhenAutoUnSqueeze                  
ShortAllWindowsMenus                 # Don't show IM and WSM in win.menu

BorderRight             117          # define "panel" area
MaxWindowSize           "2428x1401"  # constrain window size 2560x1440
# MaxWindowSize         "1796x1047"  # constrain window size 1920x1080   

#---------------------------------------------------------
# TITLEBAR CONFIG and
# TITLEBAR BUTTONS                                          
#---------------------------------------------------------

UseThreeDTitles
NoDefaults                           # not use default buttons

SunkFocusWindowTitle                 # sink instead of raise?

TitleJustification      "center"      # right/left/center

LeftTitleButton   ":xpm:bar"                = f.menu "windowctrl" # Window menu button
RightTitleButton  "xpm:box.xpm"             = f.fullzoom     # Maximize button
RightTitleButton  ":xpm:cross"              = f.delete

#---------------------------------------------------------
# BORDER CONFIG
#---------------------------------------------------------

UseThreeDBorders

ThreeDBorderWidth       6            # Had been 4

MWMIgnore {
    "DECOR_BORDER"                   # en/disable window borders
    "DECOR_TITLE"                    # en/disable titlebars
}

#---------------------------------------------------------
# WORKSPACE MANAGER CONFIG and
# WORKSPACE COLORS AND NAMES                              
# N = "Name"  |  MC = "ManagerColor"  |  MTC = "ManTextColor" 
# BC = "BackgroundColor"  |  FC = "ForegroundColor"  |  RX = "RootXpm" 
#---------------------------------------------------------

ShowWorkSpaceManager		         # start with workspace manager up
ReallyMoveInWorkspaceManager         # Move windows from WSM?
UseThreeDWMap
DontWarpCursorInWMap                 # no move to indicated win
NoShowOccupyAll                      # do not display windows open on all workspaces in Workspace Manager
ReverseCurrentWorkspace              # reverse colors in curr WS?
StartInMapState                      # buttons or maps?
DontToggleWorkSpaceManagerState      # stay in map state
NoImagesInWorkSpaceManager           # don't use wallpaper in WorkSpace Manager

WMgrHorizButtonIndent    0           # /dist. between buttons
WMgrVertButtonIndent     0           # \when in button mode

# WorkSpaceManagerGeometry      "120x544-0-120" 1      # 1920x1080
WorkSpaceManagerGeometry        "120x630-0-120" 1      # 2560x1440

WorkSpaces 
{
#    N          MC        MTC       BC       FC    RX 
    "1"    {"rgb:0/2/2" "rgb:f/f/f" "rgb:0/2/2" "rgb:f/f/f" "jpeg:backgrounds/background1.jpg"}
    "2"    {"rgb:0/0/2" "rgb:f/f/f" "rgb:0/0/2" "rgb:f/f/f" "jpeg:backgrounds/background2.jpg"}
    "3"    {"rgb:2/0/0" "rgb:f/f/f" "rgb:2/0/0" "rgb:f/f/f" "jpeg:backgrounds/background3.jpg"}
    "4"    {"rgb:2/2/2" "rgb:f/f/f" "rgb:2/2/2" "rgb:f/f/f" "jpeg:backgrounds/background4.jpg"}
    "5"    {"rgb:0/6/6" "rgb:f/f/f" "rgb:0/6/6" "rgb:f/f/f" "jpeg:backgrounds/background5.jpg"}
    "6"    {"rgb:4/4/6" "rgb:f/f/f" "rgb:4/4/6" "rgb:f/f/f" "jpeg:backgrounds/background6.jpg"}
    "7"    {"rgb:6/4/4" "rgb:f/f/f" "rgb:6/4/4" "rgb:f/f/f" "jpeg:backgrounds/background7.jpg"}
    "8"    {"rgb:6/6/6" "rgb:f/f/f" "rgb:6/6/6" "rgb:f/f/f" "jpeg:backgrounds/background8.jpg"}
    "9"    {"rgb:0/4/4" "rgb:f/f/f" "rgb:0/4/4" "rgb:f/f/f" "jpeg:backgrounds/background9.jpg"}
    "10"   {"rgb:2/2/4" "rgb:f/f/f" "rgb:2/2/4" "rgb:f/f/f" "jpeg:backgrounds/background10.jpg"}
#   "11"   {"rgb:4/2/2" "rgb:f/f/f" "rgb:4/2/2" "rgb:f/f/f" "jpeg:backgrounds/background11.jpg"}
#   "12"   {"rgb:4/4/4" "rgb:f/f/f" "rgb:4/4/4" "rgb:f/f/f" "jpeg:backgrounds/background12.jpg"}
}

MapWindowCurrentWorkSpace { "#0A5244" "#A2E7F4" "#f2f2f2" }

#---------------------------------------------------------
# ICON CONFIG and
# ICONS
#---------------------------------------------------------

ForceIcons                           # use icons put below, not default
IconifyByUnmapping                   # no icon when iconified
#NoRaiseOnDeiconify                  # raise deiconified wins?
#AutoRaiseIcons                      # raise icons when under cursor

IconJustification        "center"     # where put image/title?
MaxIconTitleWidth        120
IconBorderWidth          0           # frame around I?

SchrinkIconTitles                    # shrink icon titles a'la Motif

# Where on the screen to put icons and how to place them.
# IconRegion                "1800x105+0+0"   North West 128 100  { }
# IconRegion                "1800x105+0+110" North West 128 100  { }
# IconRegionAlignement      "bottom"
# IconRegionJustification    "center"

#---------------------------------------------------------
# ICON MANAGER CONFIG
#---------------------------------------------------------

# ShowIconManager                    # activate/deactivate IM
UseThreeDIconManagers
SortIconManager                      # sorts alphabetically
IconManagerShadowDepth   2
NoIconManagerFocus                   # !focus the win under cursor in IM

# Icon Manager Geometry:  Size:       Columns:
IconManagerGeometry		  "120x300-0+120" 1

#---------------------------------------------------------
# MOUSE POINTER CONFIG and   (cursor = mouse pointer)
# MOUSE POINTERS
#---------------------------------------------------------

Cursors
{
    Destroy   "pirate"
}



#---------------------------------------------------------
# MENU CONFIG and
# MENUS                                           
#
# Tip for menus:
# Instead of rewriting your menus for every platform you
# move your .ctwmrc-file to, you could keep all menus in
# the same file and simply add a couple of lines to the
# mouse button funcion specifications below. Here I have
# one set of menus for DEC and one for Linux. Study my
# example! :)
#---------------------------------------------------------

StayUpMenus                          # pin automatically?
# WarpToDefaultMenuEntry             # warp to menu (when using above)

UseThreeDMenus                       # 3D or not?
MenuShadowDepth          1           # how big shadow? (1 looks good)
NoBackingStore                       # /which is faster,

# Workspace Menu (Left click in root)
menu "root"
{
    "LMDE 7"                            f.title
    "Terminal"                          !"xterm &"
    ""                                  f.separator
    "File Manager"                      !"nemo &"
    "Vivaldi Browser"                   !"vivaldi-stable --password-store=gnome-libsecret --window-size=1600,960 &"
    "Music on Console"                  !"wmctrl -s 7; terminator -l music &"
#   "Music on Console"                  !"wmctrl -s 5; xterm -e 'mocp -T /usr/share/moc/themes/darkdot_theme' &"
    ""                                  f.separator
    "Utilities"                         f.menu "stgs" 
    "Applications"                      f.menu "miscapps"
}

# Workspace submenu: Settings
menu "stgs" 
{
    "Utilities"                         f.title
    "Cinnamon Settings"                 !"cinnamon-settings &"
    "BTOP++"                            !"xterm -e btop &"
    "Environment"                       !"mintEnvironment &"
    "Sun Clock"                         !"sunclock -map -mapgeom 900x474 &"
    "GLXgears"                          !"glxgears &"
    "XFontSel"                          !"xfontsel -geometry -136+6 &"
    "XOSView"                           !"xosview -geometry -136-46 &"
}

# Workspace submenu: Miscellaneous apps
menu "miscapps" 
{
    "Applications"                     f.title
    "Games"                            f.menu "games"
    "Office"                            f.menu "office"
    ""                                 f.separator
    "Calculator"                       !"xcalc -geometry 340x600+980+86 &"
    "Disks"                            !"gnome-disks &"
    "Nano"                             !"xterm -e nano &"
    "Text Editor"                      !"xed &"
    "TTY-Clock"                        !"xterm -e tty-clock -c -C 2 -r -f '%A, %B %d' -s &"
    ""                                 f.separator
    "Asunder"                          !"asunder &"
    "Audacious"                        !"audacious &"
    "Rhythmbox"                        !"rhythmbox &"
    ""                                 f.separator
    "frogr"                            !"frogr &"
    "GIMP"                             !"gimp-3.0 &"
    ""                                 f.separator
    "Alpine"                           !"wmctrl -s 4; gnome-terminal -e alpine &"
    "Filezilla"                        !"filezilla &"
    "nchat"                            !"gnome-terminal -e nchat &"
    "Vivaldi"                          !"vivaldi-stable --password-store=gnome-libsecret --window-size=1600,960 &"
    ""                                 f.separator
    "Astroterm"                        !"wmctrl -s 8; terminator -l astroterm &"
#   "Astroterm"                        !"wmctrl -s 7; xterm -T 'astroterm' -e 'astroterm --latitude=30.91 --longitude=-76.64 --metadata --color' &"
    "Calibre"                          !"calibre &"
    "Virtual Manager"                  !"virt-manager &"
}

# Workspace submenu: Games apps
menu "games" 
{
    "Games"                          f.title
    "AisleRiot"                      !"sol &"
    "FreeCell"                       !"sol --freecell &"
    "Reversi"                        !"iagno --classic --size=12 &"
    "Sudoku"                         !"gnome-sudoku &"
    "Super Star Trek"                !"xterm -e superstartrek &"
    "Tetris"                         !"xterm -e tetris &"
    "Xbomb"                          !"xbomb -hexagon &"
    "XGammon"                        !"xgammon &"
    "XNetHack"                       !"xnethack &"
}

# Workspace submenu: Office apps
menu "office" 
{
    "Office"                          f.title
    "LibreOffice"                     !"libreoffice &"
    "LibreOffice Base"                !"libreoffice --base &"
    "LibreOffice Calc"                !"libreoffice --calc &"
    "LibreOffice Draw"                !"libreoffice --draw &"
    "LibreOffice Impress"             !"libreoffice --impress &"
    "LibreOffice Math"                !"libreoffice --math &"
    "LibreOffice Writer"              !"libreoffice --writer &"
}

# System menu (Right click in root)
menu "defops" {
    "System"                           f.title
    "Resize"                           f.resize
    "Move"                             f.move
    "Kill"                             f.destroy
    "Close"                            f.delete
    ""                                 f.separator
    "Screenshot"                       !"scrot '/home/allyn/Pictures/Screenshots/Screenshot_%Y%m%d_%H%M%S.png' &"
    ""                                 f.separator
    "Sleep"                            f.menu "asksleep"
    "Lock Screen"                      !"xscreensaver-command -lock &"
    "Restart CTWM"                     f.restart
    "Exit"                             f.menu "askexit"
}

# System submenu: Confirm sleep mode
menu "asksleep" 
{
    "Sleep?"                           f.title
    "No"                               f.nop
    "Yes"                              !"systemctl suspend"
}

# System submenu: Confirm exit
menu "askexit" 
{
    "Exit?"                            f.title
    "No"                               f.nop
    "Yes"                              f.quit
}

# Window menu (Dropdown in window title bar)
menu "windowctrl"
{
    "Minimize"                         f.iconify
    "Maximize"                         f.fullzoom
    "Move"                             f.move
    "Resize"                           f.resize
    "Tile"                             f.menu "tile"
    "Info"                             f.identify
    ""                                 f.separator
    "Bring to Top"                     f.raise
    "Always on Visible Workspace"      f.occupyall
    "Move to Workspace Up"             f.movetoprevworkspace
    "Move to Workspace Down"           f.movetonextworkspace
    "Move to Another Workspace"        f.menu "workspacemove"
    ""                                 f.separator
    "Screenshot"                       !"scrot -b -u '/home/allyn/Pictures/Screenshots/Screenshot_%Y%m%d_%H%M%S.png' &"
    "Resize 1080x1080"                 !"wmctrl -r :ACTIVE: -e 0,-1,-1,1072,1047 &"
    ""                                 f.separator
    "Close"                            f.delete
}

# Window submenu: Workspace controls
menu "workspacemove" {
    "Move to Workspace 1"              !"wmctrl -r :ACTIVE: -t 0"
    "Move to Workspace 2"              !"wmctrl -r :ACTIVE: -t 1"
    "Move to Workspace 3"              !"wmctrl -r :ACTIVE: -t 2"
    "Move to Workspace 4"              !"wmctrl -r :ACTIVE: -t 3"
    "Move to Workspace 5"              !"wmctrl -r :ACTIVE: -t 4"
    "Move to Workspace 6"              !"wmctrl -r :ACTIVE: -t 5"
    "Move to Workspace 7"              !"wmctrl -r :ACTIVE: -t 6"
    "Move to Workspace 8"              !"wmctrl -r :ACTIVE: -t 7"
    "Move to Workspace 9"              !"wmctrl -r :ACTIVE: -t 8"
    "Move to Workspace 10"             !"wmctrl -r :ACTIVE: -t 9"
}

# Workspace submenu: Titling controls
menu "tile"
{
    "Tile Windows"                     f.title
# This block is for windows with gaps on a 1920x1080
